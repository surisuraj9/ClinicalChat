# ---- LLM ------------------------------------------------------------------
# auto = OpenAI when OPENAI_API_KEY is set, otherwise the local GitHub Copilot CLI
LLM_PROVIDER=auto
OPENAI_API_KEY=
# strong model for the clinician Insight agent, fast model for patient answers (streams word by word)
OPENAI_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
INSIGHT_MAX_TOKENS=900
COMMUNICATION_MAX_TOKENS=450
# Copilot CLI (local development only)
COPILOT_MODEL=gpt-4.1
COPILOT_MAX_PARALLEL=1
COPILOT_TIMEOUT_SECONDS=180
LLM_CACHE=true

# ---- Embeddings -----------------------------------------------------------
# auto = sentence-transformers/all-MiniLM-L6-v2 when available, else the ONNX export of the same model
EMBEDDING_PROVIDER=auto

# ---- Optional Langfuse tracing ----------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Web app --------------------------------------------------------------
HOST=0.0.0.0
PORT=7860
DEMO_PASSWORD=demo@123
# UI_AUTH=off shows a persona switcher instead of the login page (local dev only)
UI_AUTH=on
