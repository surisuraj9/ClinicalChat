# Template only: copy to .env (git-ignored) and put real keys THERE. NEVER put real keys in this file.
# ---- LLM ------------------------------------------------------------------
# Without OPENAI_API_KEY the AI agents are off; every rule-based feature still works.
OPENAI_API_KEY=
# strong model for the clinician Insight agent, fast model for patient answers (streams word by word)
OPENAI_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
INSIGHT_MAX_TOKENS=1600
COMMUNICATION_MAX_TOKENS=600
LLM_CACHE=true
# course specialist agents (Lab Interpreter / Radiology Analyzer / Allergy Safety, structured Pydantic output):
# auto = on when OPENAI_API_KEY is set | llm = always | rules = rule-based analysers only
SPECIALIST_AGENTS=auto
# gpt-4.1-mini: same output as the course's gpt-4o-mini, ~2.5x faster (4-5 s vs 11-14 s per specialist)
OPENAI_SPECIALIST_MODEL=gpt-4.1-mini
SPECIALIST_MAX_TOKENS=900

# ---- Embeddings -----------------------------------------------------------
# auto = OpenAI text-embedding-3-small when OPENAI_API_KEY is set, else the local all-MiniLM-L6-v2 model
# (switching provider rebuilds the vector index once). openai | local force one of them.
EMBEDDING_PROVIDER=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Optional Tavily web search (trusted medical sites only) ----------------
# patient general questions, clinician guideline evidence, unknown-medicine lookup. Off when empty.
TAVILY_API_KEY=
WEB_SEARCH=auto
WEB_SEARCH_TIMEOUT_SECONDS=4

# ---- Optional Langfuse tracing ----------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Web app --------------------------------------------------------------
HOST=0.0.0.0
# 7860 locally; the EC2 kit (deployment/) and the Docker image use 8000 like the course
PORT=7860
# password of the demo persona logins (UI and REST API). CHANGE IT on any public server.
DEMO_PASSWORD=demo@123
# UI_AUTH=off shows a persona switcher instead of the login page (local dev only)
UI_AUTH=on
